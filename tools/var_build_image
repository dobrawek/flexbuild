#!/usr/bin/env -S bash

# Build Automation Script for Embedded Systems
# Supports Debian-based root filesystems: debian:base, debian:server, debian:desktop
# Automatically manages local ARM toolchain (no Docker required)

set -e

SCRIPT_NAME=$(basename "$0")
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FBDIR="$(dirname "$SCRIPT_DIR")"

# Default configuration
MACHINE=""
COMPONENTS=""
DISTRO=""
SDK_CONFIG_FILE="sdk-var.yml"
SKIP_TOOLCHAIN_CHECK=false
ENABLE_LOGGING=true

# Setup logging
setup_logging() {
    if [ "$ENABLE_LOGGING" = true ]; then
        LOG_DIR="$FBDIR/build_lsdk2412/logs"
        mkdir -p "$LOG_DIR"
        LOG_FILE="$LOG_DIR/build_$(date +%Y%m%d_%H%M%S).log"

        # Redirect stdout and stderr to both console and log file
        exec > >(tee -a "$LOG_FILE") 2>&1

        echo "=================================================================="
        echo "Build started at: $(date)"
        echo "Log file: $LOG_FILE"
        echo "=================================================================="
    fi
}

# Colors
RED='\e[1;31m'
GREEN='\e[1;32m'
YELLOW='\e[1;33m'
BLUE='\e[1;34m'
NC='\e[0m'

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

log_step() {
    echo -e "${BLUE}[STEP]${NC} $1"
}

# Setup toolchain and build environment
setup_toolchain() {
    TOOLCHAIN_DIR="$FBDIR/toolchain"
    TOOLCHAIN_BIN="$TOOLCHAIN_DIR/bin"

    # Setup PATH for bld and toolchain
    export PATH="$TOOLCHAIN_BIN:$FBDIR/tools:$FBDIR:$PATH"
    export FBDIR="$FBDIR"

    # Create bld symlink if needed
    [ ! -L "$FBDIR/tools/bld" ] && ln -sf flex-builder "$FBDIR/tools/bld" 2>/dev/null || true

    # Check if toolchain exists
    if [ ! -f "$TOOLCHAIN_BIN/aarch64-linux-gnu-gcc" ]; then
        log_warn "Local toolchain not found at $TOOLCHAIN_BIN"
        log_info "Downloading ARM GNU Toolchain (GCC 13.3)..."

        if ! "$SCRIPT_DIR/toolchain_manager" setup-arm64; then
            log_error "Failed to setup toolchain"
            log_info "You can manually run: ./tools/toolchain_manager setup"
            return 1
        fi
    fi

    # Verify toolchain
    if [ -f "$TOOLCHAIN_BIN/aarch64-linux-gnu-gcc" ]; then
        local gcc_version=$("$TOOLCHAIN_BIN/aarch64-linux-gnu-gcc" --version | head -1)
        log_info "Using toolchain: $gcc_version"

        export CROSS_COMPILE=aarch64-linux-gnu-
        export ARCH=arm64

        return 0
    else
        log_error "Toolchain verification failed"
        return 1
    fi
}

validate_distro() {
    case "$DISTRO" in
        "debian:base"|"debian:server"|"debian:desktop")
            return 0
            ;;
        *)
            log_error "Unsupported distribution: $DISTRO"
            echo "Valid options are:"
            echo "  - debian:base    (minimal Debian installation)"
            echo "  - debian:server  (Debian with server packages)"
            echo "  - debian:desktop (Debian with desktop environment)"
            return 1
            ;;
    esac
}

validate_machine() {
    local config_file="$FBDIR/configs/board/$MACHINE.conf"
    if [ ! -f "$config_file" ]; then
        log_error "Unknown machine: $MACHINE"
        echo "Available machines:"
        ls -1 "$FBDIR/configs/board/"*.conf 2>/dev/null | xargs -I{} basename {} .conf | sed 's/^/  - /'
        return 1
    fi
    return 0
}

build_system() {
    echo ""
    echo "╔════════════════════════════════════════════════════════════════╗"
    echo "║              VARISCITE BUILD SYSTEM                            ║"
    echo "╚════════════════════════════════════════════════════════════════╝"
    echo ""
    log_info "Target Device:  $MACHINE"
    log_info "Components:     ${COMPONENTS:-auto}"
    log_info "Distribution:   $DISTRO"
    log_info "Config File:    $SDK_CONFIG_FILE"
    echo ""

    # Validate inputs
    if ! validate_machine; then
        return 1
    fi

    if ! validate_distro; then
        return 1
    fi

    # Setup toolchain
    if [ "$SKIP_TOOLCHAIN_CHECK" != true ]; then
        log_step "Setting up toolchain..."
        if ! setup_toolchain; then
            return 1
        fi
    fi

    # Build components
    if [ -n "$COMPONENTS" ]; then
        for component in $COMPONENTS; do
            log_step "Building $component for $MACHINE..."
            bld -f "$SDK_CONFIG_FILE" -m "$MACHINE" "$component" || {
                log_error "Failed to build $component"
                return 1
            }
        done
    fi

    # Build root filesystem
    log_step "Building $DISTRO root filesystem..."
    bld rfs -r "$DISTRO" -f "$SDK_CONFIG_FILE" -m "$MACHINE" || {
        log_error "Root filesystem build failed"
        return 1
    }

    # Build applications
    log_step "Building applications for $DISTRO..."
    bld apps -r "$DISTRO" -f "$SDK_CONFIG_FILE" -m "$MACHINE" || {
        log_error "Applications build failed"
        return 1
    }

    # Integrate components
    log_step "Integrating components..."
    bld merge-apps -r "$DISTRO" -f "$SDK_CONFIG_FILE" -m "$MACHINE" && \
    bld merge-bootpart-rfs -r "$DISTRO" -f "$SDK_CONFIG_FILE" -m "$MACHINE" || {
        log_error "System integration failed"
        return 1
    }

    # Build recovery SD card image
    log_step "Building Recovery SD Card image..."
    bld -r "$DISTRO" -f "$SDK_CONFIG_FILE" -m "$MACHINE" create-recovery-sdcard-image || {
        log_warn "Recovery SD card image creation failed (non-fatal)"
    }

    echo ""
    echo "╔════════════════════════════════════════════════════════════════╗"
    echo "║                    BUILD SUCCESSFUL                            ║"
    echo "╚════════════════════════════════════════════════════════════════╝"
    echo ""
    log_info "Output directory: $FBDIR/build_lsdk2412/images/"

    return 0
}

clean_system() {
    echo ""
    log_step "Cleaning $DISTRO environment..."

    local bld_args=""
    [ -n "$DISTRO" ] && bld_args="-r $DISTRO"
    [ -n "$SDK_CONFIG_FILE" ] && bld_args="$bld_args -f $SDK_CONFIG_FILE"

    bld clean $bld_args || true
    bld clean-linux $bld_args || true
    bld clean-rfs $bld_args || true
    bld clean-apps $bld_args || true

    log_info "Cleanup completed"
    return 0
}

cleanall() {
    echo ""
    log_warn "This will remove ALL build artifacts and downloaded components!"
    read -p "Are you sure? (y/N) " -n 1 -r
    echo

    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        log_info "Operation cancelled"
        return 0
    fi

    log_step "Full cleanup started..."

    clean_system

    cd "$FBDIR"
    git clean -dxf --exclude=toolchain/ || true
    rm -rf components_lsdk2412/ build_lsdk2412/

    # Re-source environment
    [ -f "$FBDIR/setup.env" ] && . "$FBDIR/setup.env"

    log_info "Full cleanup completed"
    log_info "Note: Local toolchain preserved in toolchain/"
    return 0
}

setup_only() {
    log_step "Setting up build environment..."

    # Setup toolchain
    if ! setup_toolchain; then
        return 1
    fi

    # Source environment (ignore errors from setup.env)
    cd "$FBDIR"
    export FBDIR="$FBDIR"
    export PATH="$FBDIR:$FBDIR/tools:$PATH"

    # Create bld symlink if needed
    [ ! -L "$FBDIR/tools/bld" ] && ln -sf flex-builder "$FBDIR/tools/bld" 2>/dev/null || true

    log_info "Environment ready!"
    log_info "You can now run: bld -m $MACHINE -f $SDK_CONFIG_FILE <command>"

    # Print environment info
    echo ""
    echo "Environment variables set:"
    echo "  FBDIR=$FBDIR"
    echo "  PATH includes: $TOOLCHAIN_BIN"
    echo "  CROSS_COMPILE=$CROSS_COMPILE"
    echo "  ARCH=$ARCH"

    return 0
}

show_usage() {
    cat <<EOF
Variscite Build Image - Docker-free build system

Usage: $SCRIPT_NAME <machine> <distro> [components] [options]
   or: $SCRIPT_NAME [options]

Arguments:
  <machine>      Target machine (e.g., imx8mp-var-dart, imx8mm-var-dart)
  <distro>       Target distribution (debian:base, debian:server, debian:desktop)
  [components]   Components to build (e.g., "uboot linux atf")

Options:
  --setup        Only setup toolchain and environment (no build)
  --clean        Clean the specified distribution build
  --cleanall     Clean all build environments (preserves toolchain)
  --config FILE  Specify config file (default: sdk-var.yml)
  --skip-tc      Skip toolchain check (use system toolchain)
  --no-log       Disable logging to file (default: logs to build_lsdk2412/logs/)
  -h, --help     Show this help message

Supported machines:
EOF
    ls -1 "$FBDIR/configs/board/"*.conf 2>/dev/null | xargs -I{} basename {} .conf | grep -E '^imx' | sed 's/^/  /'

    cat <<EOF

Distributions:
  debian:base    - Minimal Debian (small footprint)
  debian:server  - Debian with server packages
  debian:desktop - Debian with desktop environment (GUI)

Examples:
  # Full build with auto toolchain setup
  $SCRIPT_NAME imx8mp-var-dart debian:desktop

  # Build specific components
  $SCRIPT_NAME imx8mp-var-dart debian:desktop "uboot linux"

  # Setup environment only
  $SCRIPT_NAME imx8mp-var-dart debian:desktop --setup

  # Clean build
  $SCRIPT_NAME imx8mp-var-dart debian:desktop --clean

  # Full cleanup
  $SCRIPT_NAME --cleanall

Toolchain Management:
  The script automatically downloads ARM GNU Toolchain (GCC 13.3) if not present.
  Manual management: ./tools/toolchain_manager [setup|check|clean|info]

EOF
}

parse_arguments() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --setup)
                SETUP_ONLY=true
                shift
                ;;
            --clean)
                CLEAN_MODE=true
                shift
                ;;
            --cleanall)
                CLEANALL_MODE=true
                shift
                ;;
            --config)
                SDK_CONFIG_FILE="$2"
                shift 2
                ;;
            --skip-tc)
                SKIP_TOOLCHAIN_CHECK=true
                shift
                ;;
            --no-log)
                ENABLE_LOGGING=false
                shift
                ;;
            -h|--help)
                show_usage
                exit 0
                ;;
            -*)
                log_error "Unknown option: $1"
                show_usage
                exit 1
                ;;
            *)
                if [ -z "$MACHINE" ]; then
                    MACHINE="$1"
                elif [ -z "$DISTRO" ]; then
                    DISTRO="$1"
                elif [ -z "$COMPONENTS" ]; then
                    COMPONENTS="$1"
                else
                    log_error "Unknown argument: $1"
                    show_usage
                    exit 1
                fi
                shift
                ;;
        esac
    done
}

main() {
    # Change to project directory
    cd "$FBDIR"

    parse_arguments "$@"

    # Setup logging (after parsing args to respect --no-log)
    setup_logging

    # Handle cleanall first (doesn't need machine/distro)
    if [ "$CLEANALL_MODE" = true ]; then
        cleanall
        exit $?
    fi

    # Handle setup only
    if [ "$SETUP_ONLY" = true ]; then
        if [ -z "$MACHINE" ]; then
            MACHINE="imx8mp-var-dart"  # Default for setup
        fi
        setup_only
        exit $?
    fi

    # Handle clean
    if [ "$CLEAN_MODE" = true ]; then
        clean_system
        exit $?
    fi

    # Validate required arguments for build
    if [ -z "$MACHINE" ] || [ -z "$DISTRO" ]; then
        log_error "Missing required arguments"
        echo ""
        show_usage
        exit 1
    fi

    # Run build
    build_system
    exit $?
}

main "$@"
