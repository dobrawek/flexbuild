[binaries]
c = ['@TARGET_CROSS@gcc', '-march=armv8-a+crc+crypto', '-fstack-protector-strong', '-O2', '--sysroot=@STAGING_DIR@', '-L@STAGING_DIR@/usr/lib/aarch64-linux-gnu', '-B@STAGING_DIR@/usr/lib/aarch64-linux-gnu', '-Wl,-rpath-link,@STAGING_DIR@/usr/lib/aarch64-linux-gnu']
cpp = ['@TARGET_CROSS@g++', '-march=armv8-a+crc+crypto', '-fstack-protector-strong', '-O2', '--sysroot=@STAGING_DIR@', '-L@STAGING_DIR@/usr/lib/aarch64-linux-gnu', '-B@STAGING_DIR@/usr/lib/aarch64-linux-gnu', '-Wl,-rpath-link,@STAGING_DIR@/usr/lib/aarch64-linux-gnu']
ar = '@TARGET_CROSS@ar'
strip = '@TARGET_CROSS@strip'
ld = ['@TARGET_CROSS@ld', '--sysroot=@STAGING_DIR@', '-L@STAGING_DIR@/usr/lib/aarch64-linux-gnu']
pkgconfig = '/usr/bin/pkg-config'


# g-ir-scanner = '/usr/bin/g-ir-scanner'
# g-ir-compiler = '/usr/bin/g-ir-compiler'


[built-in options]
c_args = ['-O2', '-pipe', '-g', '-feliminate-unused-debug-types', '-I@STAGING_DIR@/usr/include/aarch64-linux-gnu']
c_link_args = ['-Wl,-O1', '-Wl,--hash-style=gnu', '-Wl,--as-needed', '-L@STAGING_DIR@/usr/lib/aarch64-linux-gnu', '-B@STAGING_DIR@/usr/lib/aarch64-linux-gnu', '-Wl,-rpath-link,@STAGING_DIR@/usr/lib/aarch64-linux-gnu']
cpp_args = ['-O2', '-pipe', '-g', '-feliminate-unused-debug-types', '-I@STAGING_DIR@/usr/include/aarch64-linux-gnu']
cpp_link_args = ['-Wl,-O1', '-Wl,--hash-style=gnu', '-Wl,--as-needed', '-L@STAGING_DIR@/usr/lib/aarch64-linux-gnu', '-B@STAGING_DIR@/usr/lib/aarch64-linux-gnu', '-Wl,-rpath-link,@STAGING_DIR@/usr/lib/aarch64-linux-gnu']


[properties]
needs_exe_wrapper = true
sys_root = '@STAGING_DIR@'
pkg_config_libdir = '@DESTDIR@/usr/lib/pkgconfig:@STAGING_DIR@/usr/lib/pkgconfig:@STAGING_DIR@/usr/lib/aarch64-linux-gnu/pkgconfig:@STAGING_DIR@/usr/share/pkgconfig'

[host_machine]
system = 'linux'
cpu_family = 'aarch64'
cpu = 'aarch64'
endian = 'little'

[target_machine]
system = 'linux'
cpu_family ='aarch64'
cpu = 'aarch64'
endian = 'little'
