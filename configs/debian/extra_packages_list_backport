# To install extra devel packages dependencies needed for compiling NXP-specific
# packages/components from source code against Debian rootfs libraries/headers
# during build-time for NXP iMX & Layerscape MPU platforms.

extra_server_devel_packages_backport=" \
    gpiod \
    libgpiod-dev \
    python3-libgpiod \
    python3-venv \
    liborc-0.4-bin \
    liborc-0.4-dev \
"

extra_desktop_devel_packages_backport=" \
    gpiod \
    libgpiod-dev \
    python3-libgpiod \
    python3-venv \
    liborc-0.4-bin \
    liborc-0.4-dev \
"
